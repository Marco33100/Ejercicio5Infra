# Copia este archivo a secrets.env (ignorado por Git) y completa los valores.
# Formato de docker --env-file: sin comillas ni espacios alrededor del "=".
# Usa solo letras, números, @ y . en las contraseñas.

# Llaves de un usuario IAM (no de la cuenta raíz).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Base de datos de la aplicación.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Usuario inicial para iniciar sesión en el cliente web.
ADMIN_EMAIL=admin@ejercicio5.local
ADMIN_PASSWORD=
